# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
*.log
npm-debug.log*
/tmp
*.swp

# Ignore Visual Studio Code files
/.vscode

# Ignore Vim backup files
*~

# Ignore Ctags files
/tags
/tags.lock
/tags.temp
/tags.files

# Ignore RubyMine files
/.idea
/frontend/.idea

/backup
/.project
/.loadpath

# Generated files
/app/assets/javascripts/editor/*
/app/assets/javascripts/locales/*.*
/frontend/src/locales/*
/modules/*/frontend/module/module
/config/additional_environment.rb
/config/configuration.yml
/config/database.yml
/config/email.yml
/config/secret_token.yml
/config/frontend_assets.manifest.json
/coverage
/db/*.db
/db/*.sqlite3
/db/schema.rb
/files/*
/log/*.log*
/log/mongrel_debug
/public/dispatch.*
/public/plugin_assets
/public/assets
/public/javascripts
/tmp/*
/tmp/cache/*
/tmp/sessions/*
/tmp/sockets/*
/tmp/test/*
/*.rbc
/doc/app
/Gemfile.local*
/Gemfile.plugins*
/.rvmrc*
/.ruby-gemset
/.foreman
/.overmind.env
.DS_Store
*.icloud
.rspec
.byebug_history

# coverage in plugins
/lib/plugins/*/coverage

# asset cache
/.sass-cache/

# Frontend debug log
/frontend/npm-debug.log*
/frontend/dist/
/frontend/tests/*.gif
node_modules/

# Ignore global package-lock.json that generates
plaintext.yml
db/*.sql

# Local development
# used by dotenv
/.env.*.local

# Local development docker
/.env
/docker-compose.override.yml

# Local development direnv files
/.envrc
/.direnv

# local user override
lefthook-local.yml
.rubocop-local.yml

# Local AI coding agent instruction overrides
AGENTS.local.md
CLAUDE.local.md

/.lefthook-local/

frontend/package-lock.json

# Testing and nextcloud infrastructure
acme.json
.env.test

# Generated seeders crowdin source file
**/config/locales/en.seeders.yml

# ---------------------------------------------------------------------------
# 爱管理 · 开源范围（白名单）
# 仓库根目录默认全部忽略，只放行构建、运行、测试与演示数据所需的内容。
# 新增根目录条目时须在此显式放行，避免文档、截图与本地产物误入仓库。
# ---------------------------------------------------------------------------
/*

# 应用代码
!/app/
!/bin/
!/config/
!/db/
!/extensions/
!/extra/
!/frontend/
!/help/
!/lib/
!/lib_static/
!/lookbook/
!/modules/
!/nix/
!/public/
!/script/
!/spec/
!/vendor/
!/vendored-plugins/

# 开发与部署
!/docker/
/docker/pullpreview/
!/docker-compose.yml
!/docker-compose.ci.yml
!/docker-compose.override.example.yml
!/start-dev.sh
!/Procfile
!/Procfile.dev
!/.env.example
!/.env.test.local.example
!/.dockerignore

# 依赖与工具链
!/Gemfile
!/Gemfile.lock
!/Gemfile.modules
!/Rakefile
!/config.ru
!/Guardfile
!/package.json
!/package-lock.json
!/frontend/package-lock.json
!/.npmrc
!/.ruby-version
!/.editorconfig
!/.rubocop.yml
!/.erb_lint.yml
!/.erb_linters/
!/.jshintignore
!/.yamllint.yml
!/.rspec_parallel
!/.redocly/
!/.redocly.yaml
!/.redocly.lint-ignore.yaml
!/lefthook.yml
!/.openproject-token.pub
!/.gitignore

# 运行期目录只保留占位文件
!/log/
/log/*
!/log/delete.me
!/files/
/files/*
!/files/delete.me

# 接口规范：运行期与接口测试读取 docs/api/apiv3 下的 YAML，其余文档不入库
!/docs/
/docs/*
!/docs/api/
/docs/api/*
!/docs/api/apiv3/
/docs/api/apiv3/**/*.png
/spec/lib/open_project/environment_variables_documentation_spec.rb

# 许可与说明
!/LICENSE
!/COPYRIGHT
!/COPYRIGHT_short

# Markdown 只保留中英文 README 与随资源分发的许可说明
*.md
!/README.md
!/README.en.md
!/modules/openid_connect/app/assets/images/openid_connect/LICENSE.md

# 本地生成的演示视图文本
/tmp/ledger-views.md

!/frontend/src/locales/.gitkeep

*Zone.Identifier