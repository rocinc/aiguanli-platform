<% html_title(t("assistant.action_page.title"), @action.title) -%>
<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t("assistant.action_page.title") }
    header.with_description { t("assistant.action_page.description") }
    if @project
      header.with_breadcrumbs(
        [{ href: project_overview_path(@project), text: @project.name },
         t("assistant.action_page.title")]
      )
    else
      header.with_breadcrumbs([{ href: my_page_path, text: t("my_page.label") }, t("assistant.action_page.title")])
    end
  end
%>

<div class="assistant-action-page">
  <div class="assistant-action-page--card">
    <%= render(Assistant::ActionCardComponent.new(action: @action, user: current_user, heading_level: 2)) %>
  </div>
  <section class="assistant-action-page--history" aria-labelledby="assistant-action-history">
    <h2 id="assistant-action-history" class="assistant-section--title"><%= t("assistant.timeline.label") %></h2>
    <%= render(Assistant::ActionTimelineComponent.new(action: @action, user: current_user)) %>
  </section>
</div>
