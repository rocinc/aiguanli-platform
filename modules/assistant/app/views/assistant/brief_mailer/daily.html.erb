<% @digest.sections.each do |key, lines| %>
  <h2><%= t("assistant.brief_mail.sections.#{key}") %></h2>
  <ul>
    <% lines.each do |line| %>
      <li>
        <% if line.project %><small><%= line.project %></small><br><% end %>
        <%= line.url ? link_to(line.text, line.url) : line.text %>
        <% if line.detail.present? %><br><small><%= line.detail %></small><% end %>
      </li>
    <% end %>
  </ul>
<% end %>
<% if @digest.deferred_count.positive? %>
  <p><%= t("assistant.brief_mail.deferred", count: @digest.deferred_count) %></p>
<% end %>
<p><%= link_to(t("assistant.brief_mail.open"), my_page_url) %></p>
<p><small><%= link_to(t("assistant.brief_mail.settings"), my_assistant_url) %></small></p>
